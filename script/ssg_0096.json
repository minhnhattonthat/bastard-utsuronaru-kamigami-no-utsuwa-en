  ],
  "fn": [
   560
  ],
  "speaker": [
   -1
  ],
  "who": [
   ""
  ],
  "jp": "自分が、ある決断をしたのが判った。{n}目の前の巨漢を、殺してしまうだけの{n}秘剣。それを使うのだ。勝つために。",
  "en": ""
 },
 {
  "id": "s0096_00b94",
  "off": 2964,
  "term": "0C",
  "max": 128,
  "kind": "text",
  "refs": [
