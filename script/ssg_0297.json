   "003"
  ],
  "fn": [
   560
  ],
  "speaker": [
   18
  ],
  "who": [
   "バ・ソリー"
  ],
  "jp": "だが、カル＝スだけは違った。戦場で{n}すら蔑まれる蟲使いの技能に敬意を{n}払うと同時に、バ・ソリーの夢に対し{n}ても理解を示した唯一の人間であった。",
  "en": ""
 },
 {
  "id": "s0297_01c8c",
  "off": 7308,
  "term": "0C",
  "max": 108,
  "kind": "text",
  "refs": [
