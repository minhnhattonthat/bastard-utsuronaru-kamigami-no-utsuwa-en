   "1000"
  ],
  "fn": [
   560
  ],
  "speaker": [
   -1
  ],
  "who": [
   ""
  ],
  "jp": "その管に吊られる形で、空洞の中央に{n}浮かぶ奇怪な建造物があった。",
  "en": ""
 },
 {
  "id": "s0342_0094c",
  "off": 2380,
  "term": "0C",
  "max": 212,
  "kind": "text",
  "refs": [
   3044
